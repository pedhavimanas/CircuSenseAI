# CircuSense AI Environment Configuration

# Optional: Google Gemini API Key for circuit reasoning and engineering assistant
# (YOLO model operates locally without requiring an API key)
GEMINI_API_KEY=""

# Backend YOLO Model Configuration
MODEL_PATH="models/best.pt"
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
IMAGE_SIZE=640
DEVICE="auto"

# Optional: Tesseract OCR Configuration
# If Tesseract is not on system PATH, circusense automatically looks in standard
# installation directories (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe).
# Uncomment to explicitly override the executable path:
# TESSERACT_CMD="C:\Program Files\Tesseract-OCR\tesseract.exe"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000"
